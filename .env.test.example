# GENERATED per shell, never a committed literal. The fixture that used to sit here was 32
# characters but only 24 BYTES, and `env.ts` now refuses it — a fixture exempt from the rule
# it exercises is how the placeholder in micro-org #142 survived every test in the estate.
export OUTBOX_SIGNING_SECRET="$(openssl rand -base64 48)"
export BILLING_LEDGER_URL='http://127.0.0.1:4402'
# RETIRED and IGNORED — env.ts reads it only to log that it is set and disregarded. Kept so a
# local run exercises that path, and spelled so it announces itself: a value that merely looks
# random is indistinguishable from a real credential to a scanner and to a reader.
export BILLING_LEDGER_TOKEN='retired-ignored-see-src-env-ts'
export LOG_LEVEL='warn'
