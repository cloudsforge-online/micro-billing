# Every variable this service reads is declared in src/env.ts and appears here; nothing else is
# passed to the container (rule 9 of docs/ecosystem/03 §2).

PORT=4000
NODE_ENV=production
LOG_LEVEL=info
CLOUDSFORGE_TAG=dev

# Rule 1: one database, named by this service's own variable. Note what is NOT here: a connection
# string for the ledger. Billing reaches the ledger over HTTP with a scoped token, never by
# connecting to its tables — AD-06.
BILLING_DATABASE_URL=postgres://cloudsforge:CHANGE_ME@postgres:5432/billing
BILLING_DATABASE_POOL_MAX=10

# Token verification. `POST /purchases` and the revoke route accept a user (or an admin) and a
# service token carrying `billing:grant`; `GET /internal/entitlements/:userId` requires a service
# token carrying `billing:read` — the scope that finally lets a service ask whether a user owns
# something. The catalogue is public.
IDENTITY_JWKS_URL=http://identity:4000/.well-known/jwks.json
IDENTITY_ISSUER=https://identity.cloudsforge.online

# HMAC key for outbound event signatures. At least 32 random characters; a placeholder is refused
# at boot rather than accepted and forged later.
OUTBOX_SIGNING_SECRET=CHANGE_ME_TO_32_RANDOM_CHARACTERS

# --- the ledger ---------------------------------------------------------------------------------

# Where the ledger is. Every purchase, renewal and refund is a balanced journal entry posted here
# with an idempotency key. Billing holds no balance of its own.
BILLING_LEDGER_URL=http://ledger:4000

# The service token billing presents, carrying `ledger:post` and `ledger:read`. Issued by
# identity's POST /service-tokens and short-lived by design — rotation IS expiry (SD-12). The
# shared PAY_SERVICE_TOKEN it replaces had no identity, no scope and no expiry.
BILLING_LEDGER_TOKEN=CHANGE_ME_TO_A_SERVICE_TOKEN

# Absolute wall-clock ceiling on a ledger call, across retries. It bounds how long a purchase
# transaction stays open, because the posting happens inside it — see the note in purchases.ts.
BILLING_LEDGER_DEADLINE_MS=5000

# How long an idempotency key is honoured. Expiring one EARLY means the next replay of it buys the
# thing a second time, so this must outlive every caller's retry horizon.
BILLING_IDEMPOTENCY_TTL_DAYS=30

# Names this replica in jobs.locked_by. Defaults to the hostname, which is the container id under
# compose and the pod name under Kubernetes.
# INSTANCE_ID=

# Database tests run only against a database whose name contains "test", because they truncate.
# Unset, every database test skips.
# BILLING_TEST_DATABASE_URL=postgres://cloudsforge:CHANGE_ME@127.0.0.1:5432/billing_test
